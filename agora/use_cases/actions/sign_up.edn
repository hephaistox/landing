;; Use case: signing up.
;;
;; Two people create their account: one with Google, one with a password. Each sign-up
;; creates a person, and the user that is its account, and touches nothing else: the first
;; one starts from a repository already holding another user. Every account carries its
;; :provider-id: the id at Google (fictional here), or the login of a password account. One
;; signs up once: not while logged in, nor again with the same account.
;!zprint {:map {:sort? false}}
[;; ********************************************************************************
 {:description "Anthony signs up with his Google account."
  :by :anonymous
  :action agora.action.sign-up/sign-up
  :input {:description "The repository holds another user, who is left untouched."
          :repository {:persons [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5ffff"
                                  :name "Han solo"}]
                       :users [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5ffff"
                                :provider :google
                                :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5ffff"}]}}
  :parameter {:description "His display name, and Google to log in."
              :data {:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                     :name "Anthony"
                     :provider :google
                     :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}}
  :output {:description "A person, and the user that is his Google account."
           :created {:persons [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                :name "Anthony"}]
                     :users [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                              :provider :google
                              :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}]}}}
 ;; ********************************************************************************
 {:description "Raphaël signs up with a password."
  :by :anonymous
  :action agora.action.sign-up/sign-up
  :input {:description "Anthony has already signed up."
          :repository {:persons [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                  :name "Anthony"}]
                       :users [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                :provider :google
                                :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}]}}
  :parameter {:description "His display name, and a login and password to log in."
              :data {:id #uuid "362e5e53-a302-487a-bfb5-c7c7293fef5d"
                     :name "Raphaël"
                     :provider :password
                     :provider-id "raphael"}}
  :output {:description "A second person, and the user that is his account."
           :created {:persons [{:id #uuid "362e5e53-a302-487a-bfb5-c7c7293fef5d"
                                :name "Raphaël"}]
                     :users [{:id #uuid "362e5e53-a302-487a-bfb5-c7c7293fef5d"
                              :provider :password
                              :provider-id "raphael"}]}}}
 ;; ********************************************************************************
 {:description "Anthony, already logged in, tries to sign up again."
  :by {:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}
  :action agora.action.sign-up/sign-up
  :input {:description "Anthony has signed up and is logged in."
          :repository {:persons [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                  :name "Anthony"}]
                       :users [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                :provider :google
                                :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}]}}
  :parameter {:description "Another account, with a password."
              :data {:id #uuid "9b0e6f1a-3c2d-4e5f-8a7b-1c2d3e4f5a6b"
                     :name "Anthony bis"
                     :provider :password
                     :provider-id "anthony-bis"}}
  :output {:description "Refused: one signs up before having an account."
           :error {:reason :already-logged-in}}}
 ;; ********************************************************************************
 {:description "Anthony, logged out, tries to sign up again with his Google account."
  :by :anonymous
  :action agora.action.sign-up/sign-up
  :input {:description "Anthony has signed up with Google."
          :repository {:persons [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                  :name "Anthony"}]
                       :users [{:id #uuid "05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"
                                :provider :google
                                :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}]}}
  :parameter {:description "A new id and name, but the same Google account."
              :data {:id #uuid "b7d4e2a9-6c1f-4b38-9e05-3a8f1d7c2e64"
                     :name "Anthony"
                     :provider :google
                     :provider-id "google-05ca77b3-1355-4f39-b59c-6ea1dbb5a13d"}}
  :output {:description "Refused: this Google account already has a user."
           :error {:reason :already-signed-up}}}
 ;; ********************************************************************************
 {:description "Raphaël, logged out, tries to sign up again with his login."
  :by :anonymous
  :action agora.action.sign-up/sign-up
  :input {:description "Raphaël has signed up with a password."
          :repository {:persons [{:id #uuid "362e5e53-a302-487a-bfb5-c7c7293fef5d"
                                  :name "Raphaël"}]
                       :users [{:id #uuid "362e5e53-a302-487a-bfb5-c7c7293fef5d"
                                :provider :password
                                :provider-id "raphael"}]}}
  :parameter {:description "A new id and name, but the same login."
              :data {:id #uuid "d2a6f0c8-41b7-4e95-8c3a-6f1e9b2d7a50"
                     :name "Raphaël bis"
                     :provider :password
                     :provider-id "raphael"}}
  :output {:description "Refused: this login already has a user."
           :error {:reason :already-signed-up}}}]
