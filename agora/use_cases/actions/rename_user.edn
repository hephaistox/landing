;; Use case: renaming a user.
;;
;; A user changes the name agora shows for them. What they wrote designates them by their id,
;; so it shows the new name, and no timestamp breaks. A user's name is unique among users,
;; regardless of case and accents.
;!zprint {:map {:sort? false}}
[;; ********************************************************************************
 {:description "Hephaistox takes the name « Héphaïstos »."
  :by {:id #uuid "61a3d5a4-a94a-4e02-9e1e-0db6f5c03503"}
  :action agora.action.rename-user/rename-user
  :input {:description "Hephaistox, Hephaistox2 and Agora have an account."
          :snapshots ["type-vocabulary.edn"]}
  :parameter {:description "The new name."
              :data {:name "Héphaïstos"}}
  :output {:description "His person has the new name."
           :changed {:persons [{:name "Héphaïstos"
                                :id #uuid "61a3d5a4-a94a-4e02-9e1e-0db6f5c03503"}]}}}
 ;; ********************************************************************************
 {:description "Hephaistox2 tries to take the name « HÉPHAISTOX »."
  :by {:id #uuid "8e2ad0d5-c936-49ca-ada3-9e7dd84d13a9"}
  :action agora.action.rename-user/rename-user
  :input {:description "Hephaistox, Hephaistox2 and Agora have an account."
          :snapshots ["type-vocabulary.edn"]}
  :parameter {:description "The new name."
              :data {:name "HÉPHAISTOX"}}
  :output {:description "Refused: another user has that name, regardless of case and accents."
           :error {:reason :name-taken}}}
 ;; ********************************************************************************
 {:description "Hephaistox changes the case of his own name."
  :by {:id #uuid "61a3d5a4-a94a-4e02-9e1e-0db6f5c03503"}
  :action agora.action.rename-user/rename-user
  :input {:description "Hephaistox, Hephaistox2 and Agora have an account."
          :snapshots ["type-vocabulary.edn"]}
  :parameter {:description "The new name."
              :data {:name "HEPHAISTOX"}}
  :output {:description "His own name is not taken from him."
           :changed {:persons [{:name "HEPHAISTOX"
                                :id #uuid "61a3d5a4-a94a-4e02-9e1e-0db6f5c03503"}]}}}
 ;; ********************************************************************************
 {:description "Someone not logged in tries to rename."
  :by :anonymous
  :action agora.action.rename-user/rename-user
  :input {:description "Hephaistox, Hephaistox2 and Agora have an account."
          :snapshots ["type-vocabulary.edn"]}
  :parameter {:description "The new name."
              :data {:name "Personne"}}
  :output {:description "Refused: one must be logged in."
           :error {:reason :not-logged-in}}}
 ;; ********************************************************************************
 {:description "Someone logged in with an id no user has (9e2b7c41…) tries to rename."
  :by {:id #uuid "9e2b7c41-3d5a-4f86-b1c0-7a4e2d9f6b13"}
  :action agora.action.rename-user/rename-user
  :input {:description "Hephaistox, Hephaistox2 and Agora have an account."
          :snapshots ["type-vocabulary.edn"]}
  :parameter {:description "The new name."
              :data {:name "Personne"}}
  :output {:description "Refused: no user has this id."
           :error {:reason :unknown-user}}}]
