{:deps {com.github.hephaistox/auto-build {:git/sha "352489ce3a95900c88edb61e07e86160c09d4d9c"}}
 :paths ["scripts"]
 :tasks
 {:init (def pars
          {:target-dir "target/uberjar"
           ;; every shadow-cljs frontend build bundled into the jar
           :fe-builds ["app-admin" "agora"]})
  :requires [[auto-build.os.exit-codes]
             [auto-build.os.exiting :refer [exit]]
             [auto-build.echo :refer [level1-header]]]
  bp {:doc "To fail fast before git pushing a version"
      :requires [[auto-build.tasks.deps :as td]]
      :task (binding [exit (fn [exit-code & _] (when-not (zero? exit-code) exit-code))]
              (-> (or (do (run 'update-website) nil)
                      (run 'format)
                      (run 'lint)
                      (td/task level1-header ".")
                      (binding [*command-line-args* (conj *command-line-args* "all")]
                        (run 'clj-test))
                      (binding [*command-line-args* (conj *command-line-args* "all")]
                        (run 'cljs-node-test))
                      auto-build.os.exit-codes/ok)
                  System/exit))}
  clean {:doc "Remove temporary build files"
         :requires [[auto-build.tasks.clean :as task-clean]]
         :task (-> (task-clean/clean level1-header
                                     "."
                                     [".DS_Store"]
                                     ["resources/public/js/compiled"
                                      "logs"
                                      ".cpcache"
                                      ".shadow-cljs"
                                      "target"
                                      "node_modules"
                                      ".clj-kondo/.cache"]
                                     (current-task))
                   exit)}
  clj-test {:doc "Test with clj"
            :requires [[auto-build.tasks.clj-test :as build-clj-test]]
            :task (some->> ["test-clj"]
                           ;; `:agora-cli` puts env/cli on the classpath so the corpus tool test (which lives
                           ;; in test/unit/clj and requires landing.agora.document.corpus from env/cli) resolves.
                           (build-clj-test/clj-test level1-header
                                                    "."
                                                    "clj-test-runner:env-dev:agora-cli"
                                                    (current-task))
                           exit)}
  cljs-browser-test
  {:doc "Test with cljs in browser"
   :requires [[auto-build.tasks.cljs-browser-test :as build-cljs-browser]]
   :task (->
           (build-cljs-browser/cljs-browser-test level1-header "." (current-task) ["browser-test"])
           exit)}
  cljs-node-test
  {:doc "Test with cljs"
   :requires [[auto-build.tasks.cljs-node-test :as build-cljs-node-test]]
   :task (-> (build-cljs-node-test/cljs-node-test level1-header "." (current-task) ["ltest"])
             exit)}
  copy {:doc "Copy files from source projects (as defined in ext_src.edn)"
        :requires [[auto-build.tasks.copy :as tc]]
        :task (tc/run level1-header "ext_src.edn")}
  deps {:doc "Update deps clojure(script) and npm"
        :task (do (shell "clj -M:antq") (shell "npm upgrade"))}
  format {:doc "Format source code"
          :requires [[auto-build.tasks.formatting :as task-format]]
          :task (-> (task-format/format level1-header "." (current-task))
                    exit)}
  gha {:doc "To be run by github action"
       :task (do (shell "bb clj-test test-clj -v") (shell "bb cljs-node-test all -v"))}
  heph-info {:doc "Hephaistox project info"
             :requires [[auto-build.tasks.heph-info :as heph-info]]
             :task (-> (heph-info/heph-info level1-header (current-task) ".")
                       exit)}
  la {:doc "Deploy current codebase to local acceptance"
      :requires [[auto-build.tasks.web.prod-build :as task-prod-build] [cache-bust]]
      :task (cache-bust/deploy! task-prod-build/build
                                level1-header
                                (current-task)
                                (:fe-builds pars)
                                "LANDING_LA_REPO"
                                "target/la")}
  lint {:doc "Lint source code"
        :requires [[auto-build.tasks.lint :as task-lint]]
        :task (-> (task-lint/lint level1-header ["src" "test" "scripts"] "." (current-task))
                  exit)}
  prod {:doc "Deploy current codebase to production"
        :requires [[auto-build.tasks.web.prod-build :as task-prod-build] [cache-bust]]
        :task (cache-bust/deploy! task-prod-build/build
                                  level1-header
                                  (current-task)
                                  (:fe-builds pars)
                                  "LANDING_PROD_REPO"
                                  "target/prod")}
  prod-local {:doc "Compile frontends (app-admin + agora) + backend in prod mode, run locally"
              :requires [[cache-bust]]
              :task (do (shell "rm -rf resources/public/js/compiled" (:target-dir pars))
                        (shell "npm install")
                        (apply shell "npx shadow-cljs release" (:fe-builds pars))
                        (shell "clojure -T:uberjar :target-dir" (:target-dir pars))
                        (cache-bust/fingerprint-jar! (str (:target-dir pars) "/landing.jar"))
                        (shell "java -jar" (str (:target-dir pars) "/landing.jar")))}
  repl {:doc "Clojure repl"
        :override-builtin true
        :requires [[auto-build.tasks.repl :as build-repl]]
        ;; :env-seed puts the seed namespaces (types-seed / art-of-war-seed) on the REPL
        ;; classpath too, so one REPL can both compile-check and run seeds. Extra path only,
        ;; no deps, no side effects on startup.
        :task (-> (build-repl/repl level1-header
                                   "."
                                   (current-task)
                                   [:env-dev :test-clj :env-seed :agora-cli]
                                   7051)
                  exit)}
  repl-fe {:doc "Clojure repl for frontend"
           :override-builtin true
           :requires [[auto-build.tasks.repl-fe :as build-repl-fe]]
           :task (-> (build-repl-fe/repl-fe level1-header "." (current-task) (:fe-builds pars))
                     exit)}
  uberjar {:doc "Build the uberjar (bundles the app-admin + agora frontends)"
           :override-builtin true
           :task (do (shell "rm -rf resources/public/js/compiled" (:target-dir pars))
                     (shell "npm install")
                     (apply shell "npx shadow-cljs release" (:fe-builds pars))
                     (shell "clojure -T:uberjar :target-dir" (:target-dir pars)))}
  update-website {:doc "Re-inject fragments into resources/public/<lang>/*.html"
                  :task (load-file "scripts/fragments.bb")}}}
