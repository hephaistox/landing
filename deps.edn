                            :git/url "https://github.com/hephaistox/auto-web"
                            :hephaistox/dir "../auto_web"
                            :hephaistox/root "auto_web_cljc"
                            :hephaistox/url "https://github.com/hephaistox/auto-web"}
                           com.github.hephaistox/auto-web-cljs
                           {:deps/root "auto_web_cljs"
                            :git/sha "e7446ec83262c36baecf3af11c7530b0d2e97eb8"
                            :git/url "https://github.com/hephaistox/auto-web"
                            :hephaistox/dir "../auto_web"
                            :hephaistox/root "auto_web_cljs"
                            :hephaistox/url "https://github.com/hephaistox/auto-web"}
                           day8.re-frame/http-fx {:mvn/version "0.2.4"}
                           day8.re-frame/tracing {:mvn/version "0.9.2"}
                           metosin/reitit {:mvn/version "0.10.1"}
                           metosin/reitit-swagger {:mvn/version "0.10.1"}
                           re-frame/re-frame {:mvn/version "1.4.7"}
                           re-frisk/re-frisk {:mvn/version "1.7.1"}
                           re-pressed/re-pressed {:mvn/version "0.3.2"}
                           reagent/reagent {:mvn/version "2.0.1"}
                           superstructor/re-frame-fetch-fx {:mvn/version "0.4.0"}
                           thheller/shadow-cljs {:mvn/version "3.4.11"}}
              :extra-paths ["src/cljc" "src/cljs" "test/unit/cljc"]}
  :codox {:exec-args {:description "`landing` is the Hephaistox public website"
                      :doc-paths ["docs/codox"]
                      :metadata {:doc/format :markdown}
                      :name "landing"
                      :source-uri
                      "https://github.com/hephaistox/landing/blob/{version}/{filepath}#L{line}"}
          :exec-fn codox.main/generate-docs
          :extra-deps {codox/codox {:mvn/version "0.10.8"}}}
  :env-dev {:extra-paths ["env/dev"]}
  :env-prod {:exec-fn landing.server/-main
             :extra-paths ["env/prod"]}
  :test-clj {:extra-deps {ring/ring-mock {:mvn/version "0.6.2"}}
             :extra-paths ["test/unit/clj" "test/unit/cljc"]
             :jvm-opts ["-Djdk.attach.allowAttachSelf=true"]
             :main-opts
             ["-m" "cognitect.test-runner" "-r" ".*-test.*" "-d" "test/unit/clj" "test/unit/cljc"]}
  :test-demo {:extra-paths ["test/demo/clj"]
              :jvm-opts ["-Djdk.attach.allowAttachSelf=true"]
              :main-opts ["-m" "cognitect.test-runner" "-r" ".*-test.*" "-d" "test/unit/clj"]}
  :uberjar {:exec-args {:class-dir "target/classes"
                        :jarname "landing.jar"
                        :major-version "1.0"
                        :production-dir "target/uberjar"
                        :root-dir "target"}
            :exec-fn jar/uber
            :extra-deps {io.github.clojure/tools.build {:git/sha
                                                        "9d9563416bb09a347912b2bd202f8b8aecfa77d4"}}
            :extra-paths ["env/build"]}}
 :deps
