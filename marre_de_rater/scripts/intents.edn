;; Marre-de-rater — ENGINE INPUT: user INTENTS (disposable sandbox).
;;
;; A user intent is the MINIMAL expression of what someone doesn't want to miss.
;; It carries NO probe/source details — deciding which probes could find it is the
;; engine's job (layer 1). This is just "what I'm after, of what kind, in what
;; language".
;;
;; INTENT shape:
;;   :id     stable id
;;   :owner  who to notify
;;   :query  free text of what they're after  ("Le Seigneur des anneaux")
;;   :kind   :movie | :tv-show | :anime | :all
;;   :lang   :fr | :en

{:intents [{:id "i-lotr"
            :kind :movie
            :lang :fr
            :owner "alice@example.com"
            :query "Le Seigneur des anneaux"}
           {:id "i-batman"
            :kind :movie
            :lang :fr
            :owner "bob@example.com"
            :query "batman"}
           {:id "i-dune-en"
            :kind :movie
            :lang :en
            :owner "dave@example.com"
            :query "Dune"}]}
